aws_region         = "us-west-2"
cluster_name       = "kubevista-dev"
kubernetes_version = "1.36"

# Use the role created by IAM Identity Center or a dedicated administrator role.
admin_principal_arn = "arn:aws:iam::123456789012:role/AWSReservedSSO_AdministratorAccess_example"

# Leave empty for a private-only API endpoint. For temporary local access, use
# your exact public /32 address; never use 0.0.0.0/0.
public_access_cidrs = []

single_nat_gateway       = true
monthly_budget_usd       = 100
budget_notification_email = "you@example.com"

# External Secrets can read only Secrets Manager entries under this name prefix.
external_secret_prefix = "kubevista/"

# Delegate this subdomain to the Route53 name servers emitted by
# output.public_delivery.delegated_name_servers before enabling the Ingress.
# public_zone_name  = "kubevista.example.com"
# public_admin_email = "you@example.com"

# Set immediately before an ephemeral apply; automation calculates this value.
# expires_at = "2026-09-01T02:00:00Z"
